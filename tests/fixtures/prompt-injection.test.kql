// Self-contained fixture for repeated prompt-injection indicators.
let AttemptThreshold = 3;
let SuspiciousTerms = dynamic(["ignore previous instructions", "reveal your system prompt", "jailbreak"]);
let Input = datatable(TimeGenerated:datetime, UserPrincipalName:string, SourceIP:string, Application:string, Prompt:string)
[
    datetime(2026-09-28T12:00:00Z), "attacker@example.com", "203.0.113.50", "AI Portal", "ignore previous instructions",
    datetime(2026-09-28T12:01:00Z), "attacker@example.com", "203.0.113.50", "AI Portal", "reveal your system prompt",
    datetime(2026-09-28T12:02:00Z), "attacker@example.com", "203.0.113.50", "AI Portal", "jailbreak",
    datetime(2026-09-28T12:03:00Z), "user@example.com", "198.51.100.5", "AI Portal", "summarize this report"
];
let Detection = Input
| where Prompt has_any (SuspiciousTerms)
| summarize AttemptCount=count() by UserPrincipalName, SourceIP, Application
| where AttemptCount >= AttemptThreshold;
print TestPassed=toscalar(Detection | summarize Result=count()) == 1,
    DetectedUser=toscalar(Detection | take 1 | project UserPrincipalName)
