// Self-contained fixture for password-spray threshold behavior.
let UserThreshold = 3;
let InvalidCredentialCodes = dynamic(["50126", "50053", "50055", "50056"]);
let Input = datatable(TimeGenerated:datetime, IPAddress:string, UserPrincipalName:string, ResultType:string, AppDisplayName:string)
[
    datetime(2026-09-28T12:00:00Z), "203.0.113.10", "a@example.com", "50126", "Portal",
    datetime(2026-09-28T12:01:00Z), "203.0.113.10", "b@example.com", "50126", "Portal",
    datetime(2026-09-28T12:02:00Z), "203.0.113.10", "c@example.com", "50126", "Portal",
    datetime(2026-09-28T12:03:00Z), "198.51.100.20", "d@example.com", "50126", "Portal",
    datetime(2026-09-28T12:04:00Z), "198.51.100.20", "e@example.com", "0", "Portal"
];
let Detection = Input
| where ResultType in (InvalidCredentialCodes)
| summarize FailedUsers=dcount(UserPrincipalName) by IPAddress
| where FailedUsers >= UserThreshold;
print TestPassed=toscalar(Detection | summarize Result=count()) == 1,
    DetectedIP=toscalar(Detection | take 1 | project IPAddress)
