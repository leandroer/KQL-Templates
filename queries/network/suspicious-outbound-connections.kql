// Name: Suspicious Outbound Connections
// Description: Summarizes outbound network connections to uncommon remote ports.
// Query Type: Hunting
// Platforms: Microsoft Defender XDR Advanced Hunting
// Tables: DeviceNetworkEvents
// Required Connectors: Microsoft Defender XDR
// MITRE ATT&CK: T1041 Exfiltration Over C2 Channel
// Severity: Medium
// Lookback: 24h
// Entity Fields: RemoteIP, DeviceName
// False Positives: Custom applications, development services, and approved remote administration
// Tuning Guidance: Combine ports with reputation, prevalence, process, and destination context
// Response Guidance: Review initiating processes, destination reputation, transferred bytes, and persistence
// Validation Status: Example
// Related Analytics Rule: None

let SuspiciousPorts = dynamic([4444, 1337, 8081, 9001, 31337]);
DeviceNetworkEvents
| where Timestamp > ago(24h)
| where RemotePort in (SuspiciousPorts)
| summarize ConnectionCount=count(), Devices=make_set(DeviceName, 50), Processes=make_set(InitiatingProcessFileName, 50)
    by RemoteIP, RemotePort
| extend DetectionName = "Suspicious Outbound Connection"
| extend Severity = "Medium"
| extend TimeGenerated=now()
| project TimeGenerated, DetectionName, Severity, RemoteIP, RemotePort, ConnectionCount, Devices, Processes
