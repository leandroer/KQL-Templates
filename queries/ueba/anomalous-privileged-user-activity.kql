// Name: Anomalous Privileged User Activity
// Description: Enriches high-priority UEBA activity with current identity role and blast-radius context.
// Author: Leandro Rocha
// Version: 1.0.0
// Last Updated: 2026-09-28
// Query Type: Detection
// Platforms: Microsoft Sentinel UEBA
// Tables: BehaviorAnalytics, IdentityInfo
// Required Connectors: Microsoft Sentinel UEBA and supported identity provider
// MITRE ATT&CK: T1078 Valid Accounts
// Severity: High
// Lookback: 1h activity, 14d identity context
// Entity Fields: UserPrincipalName, SourceIPAddress, SourceDevice
// False Positives: Approved privileged administration from a new location or device
// Tuning Guidance: Adjust privileged role terms and minimum anomaly score for the tenant
// Response Guidance: Validate the administrator, review source activity, and scope subsequent actions
// Validation Status: Example
// Related Analytics Rule: analytics-rules/ueba/anomalous-privileged-user-activity.yaml

let Lookback = 1h;
let MinimumPriority = 7;
let PrivilegedRoleTerms = dynamic(["admin", "privileged", "security operator", "global reader"]);
let LatestIdentity =
    IdentityInfo
    | where TimeGenerated > ago(14d)
    | extend IdentityUPN = tostring(column_ifexists("AccountUPN", "")),
        Roles = tostring(column_ifexists("AssignedRoles", "")),
        BlastRadius = tostring(column_ifexists("BlastRadius", ""))
    | where isnotempty(IdentityUPN)
    | summarize arg_max(TimeGenerated, *) by IdentityUPN;
BehaviorAnalytics
| where TimeGenerated > ago(Lookback)
| where InvestigationPriority >= MinimumPriority
| join kind=inner LatestIdentity on $left.UserPrincipalName == $right.IdentityUPN
| where Roles has_any (PrivilegedRoleTerms) or BlastRadius =~ "High"
| project TimeGenerated, UserPrincipalName, InvestigationPriority, ActivityType,
    SourceIPAddress, SourceIPLocation, SourceDevice, Roles, BlastRadius,
    ActivityInsights, UsersInsights
