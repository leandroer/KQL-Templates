// Name: Newly Observed Identity with Anomalous Activity
// Description: Identifies high-priority activity for users absent from an earlier BehaviorAnalytics history. This does not prove account dormancy.
// Author: Leandro Rocha
// Version: 1.0.0
// Last Updated: 2026-09-28
// Query Type: Hunting
// Platforms: Microsoft Sentinel UEBA
// Tables: BehaviorAnalytics
// Required Connectors: Microsoft Sentinel UEBA and supported activity sources
// MITRE ATT&CK: T1078 Valid Accounts
// Severity: High
// Lookback: 30d baseline, 24h detection window
// Entity Fields: UserPrincipalName, SourceIPAddress
// False Positives: Newly monitored identities, source onboarding changes, or identities without earlier UEBA records
// Tuning Guidance: Increase the baseline window and exclude known infrequent service identities
// Response Guidance: Verify account ownership and investigate authentication and post-authentication activity
// Validation Status: Example
// Related Analytics Rule: None

let DetectionWindow = 24h;
let BaselineWindow = 30d;
let MinimumPriority = 7;
let HistoricallyActiveUsers =
    BehaviorAnalytics
    | where TimeGenerated between (ago(BaselineWindow) .. ago(DetectionWindow))
    | where isnotempty(UserPrincipalName)
    | summarize by UserPrincipalName;
BehaviorAnalytics
| where TimeGenerated > ago(DetectionWindow)
| where InvestigationPriority >= MinimumPriority
| where isnotempty(UserPrincipalName)
| join kind=leftanti HistoricallyActiveUsers on UserPrincipalName
| project TimeGenerated, UserPrincipalName, InvestigationPriority, ActivityType,
    SourceIPAddress, SourceIPLocation, SourceDevice, ActivityInsights
