// Name: Service Account Behavior Anomaly
// Description: Finds high-priority UEBA activity involving identities tagged or named as service accounts.
// Author: Leandro Rocha
// Version: 1.0.0
// Last Updated: 2026-09-28
// Query Type: Hunting
// Platforms: Microsoft Sentinel UEBA
// Tables: BehaviorAnalytics, IdentityInfo
// Required Connectors: Microsoft Sentinel UEBA and supported identity provider
// MITRE ATT&CK: T1078.004 Cloud Accounts
// Severity: High
// Lookback: 24h activity, 14d identity context
// Entity Fields: UserPrincipalName, SourceIPAddress, SourceDevice
// False Positives: Planned automation changes, credential rotation, or workload migration
// Tuning Guidance: Replace naming patterns with authoritative account tags where available
// Response Guidance: Confirm workload ownership and inspect credentials, permissions, and recent executions
// Validation Status: Example
// Related Analytics Rule: None

let MinimumPriority = 7;
let LatestIdentity =
    IdentityInfo
    | where TimeGenerated > ago(14d)
    | extend IdentityUPN = tostring(column_ifexists("AccountUPN", "")),
        AccountTagsText = tostring(column_ifexists("AccountTags", ""))
    | where isnotempty(IdentityUPN)
    | summarize arg_max(TimeGenerated, *) by IdentityUPN;
BehaviorAnalytics
| where TimeGenerated > ago(24h)
| where InvestigationPriority >= MinimumPriority
| join kind=inner LatestIdentity on $left.UserPrincipalName == $right.IdentityUPN
| where AccountTagsText has "ServiceAccount"
    or UserPrincipalName matches regex @"(?i)(svc|service|automation|bot)[-_.]"
| project TimeGenerated, UserPrincipalName, InvestigationPriority, ActivityType,
    SourceIPAddress, SourceIPLocation, SourceDevice, AccountTagsText, ActivityInsights
