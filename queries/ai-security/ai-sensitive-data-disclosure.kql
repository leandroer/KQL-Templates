// Name: AI Sensitive Data Disclosure
// Description: Detects secrets or sensitive terms in AI prompts or responses.
// Query Type: Hunting
// Platforms: Microsoft Sentinel, custom AI telemetry
// Tables: AIApp_CL
// Required Connectors: Custom Logs via AMA
// MITRE ATT&CK: T1552 Unsecured Credentials
// Severity: Critical
// Lookback: 24h
// Entity Fields: UserPrincipalName_s, SourceIP_s
// False Positives: Test prompts, synthetic data, or approved red-team activity
// Tuning Guidance: Replace keywords with tenant classifications and content-safety signals
// Response Guidance: Revoke exposed secrets, preserve evidence, and notify the SOC and data owner
// Validation Status: Example
// Related Analytics Rule: analytics-rules/ai-security/sensitive-data-disclosure.yaml

let SensitiveTerms = dynamic(["api_key", "client_secret", "password", "Authorization: Bearer", "BEGIN PRIVATE KEY", "access_token"]);
AIApp_CL
| where TimeGenerated > ago(24h)
| where Prompt_s has_any (SensitiveTerms) or Response_s has_any (SensitiveTerms)
| extend DetectionName = "AI Sensitive Data Disclosure"
| extend Severity = "Critical"
| project TimeGenerated, DetectionName, Severity, UserPrincipalName_s, SourceIP_s, SessionId_s, Application_s, Prompt_s, Response_s
