// Name: ASIM Password Spray Indicator
// Description: Detects one source IP producing authentication failures across many users using normalized authentication events.
// Query Type: Hunting
// Platforms: Microsoft Sentinel ASIM
// Tables: _Im_Authentication parser
// Required Connectors: Any source supported by the ASIM Authentication schema
// MITRE ATT&CK: T1110.003 Password Spraying
// Severity: High
// Lookback: 1h
// Entity Fields: SrcIpAddr, TargetUsername
// False Positives: Shared egress, identity testing, or misconfigured applications
// Tuning Guidance: Validate parser parameters and exclude approved identity infrastructure
// Response Guidance: Review impacted identities, source context, and successful follow-on authentications
// Validation Status: Example
// Related Analytics Rule: None

let Lookback = 1h;
let UserThreshold = 15;
_Im_Authentication(starttime=ago(Lookback))
| where EventResult =~ "Failure"
| summarize FailedUsers=dcount(TargetUsername), Users=make_set(TargetUsername, 100),
    Applications=make_set(TargetAppName, 50) by SrcIpAddr, bin(TimeGenerated, 30m)
| where FailedUsers >= UserThreshold
| project TimeGenerated, SrcIpAddr, FailedUsers, Users, Applications
