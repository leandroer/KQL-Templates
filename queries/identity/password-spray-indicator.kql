// Name: Password Spray Indicator
// Description: Detects one source IP failing authentication against many users.
// Query Type: Detection
// Platforms: Microsoft Sentinel, Microsoft Entra ID
// Tables: SigninLogs
// Required Connectors: Microsoft Entra ID
// MITRE ATT&CK: T1110.003 Password Spraying
// Severity: High
// Lookback: 24h
// Entity Fields: IPAddress
// False Positives: Shared egress, identity testing, or misconfigured enterprise applications
// Tuning Guidance: Use tenant-specific invalid-credential codes and exclude approved scanners
// Response Guidance: Review impacted users and successful follow-on sign-ins; block malicious sources
// Validation Status: Example
// Related Analytics Rule: analytics-rules/identity/password-spray.yaml

let Lookback = 24h;
let UserThreshold = 15;
let InvalidCredentialCodes = dynamic(["50126", "50053", "50055", "50056"]);
SigninLogs
| where TimeGenerated > ago(Lookback)
| where tostring(ResultType) in (InvalidCredentialCodes)
| summarize FailedUsers=dcount(UserPrincipalName), Users=make_set(UserPrincipalName, 100), Apps=make_set(AppDisplayName, 50)
    by IPAddress, bin(TimeGenerated, 30m)
| where FailedUsers >= UserThreshold
| extend DetectionName = "Potential Password Spray"
| extend Severity = "High"
| project TimeGenerated, DetectionName, Severity, IPAddress, FailedUsers, Users, Apps
