// Name: Password Spray Indicator
// Description: Detects one source IP failing authentication against many users.
// Data Source: SigninLogs
// Response: Block source IP if malicious, review impacted users, check for successful follow-on sign-ins.

let Lookback = 24h;
let UserThreshold = 15;
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ResultType != 0
| summarize FailedUsers=dcount(UserPrincipalName), Users=make_set(UserPrincipalName, 100), Apps=make_set(AppDisplayName, 50)
    by IPAddress, bin(TimeGenerated, 30m)
| where FailedUsers >= UserThreshold
| extend DetectionName = "Potential Password Spray"
| extend Severity = "High"
| project TimeGenerated, DetectionName, Severity, IPAddress, FailedUsers, Users, Apps
