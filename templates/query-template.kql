// Name:
// Description:
// Author:
// Version:
// Last Updated:
// Query Type: Hunting | Investigation | Detection
// Platforms:
// Tables:
// Required Connectors:
// MITRE ATT&CK:
// Severity:
// Lookback:
// Entity Fields:
// False Positives:
// Tuning Guidance:
// Response Guidance:
// Validation Status: Example | Lab Tested | Production Validated
// Related Analytics Rule:

let Lookback = 24h;
let Threshold = 10;
TableName
| where TimeGenerated > ago(Lookback)
| where <condition>
| summarize EventCount=count(), Examples=make_set(<ColumnName>, 50) by <Entity>, bin(TimeGenerated, 1h)
| where EventCount >= Threshold
| extend DetectionName = ""
| extend Severity = ""
| project TimeGenerated, DetectionName, Severity, <Entity>, EventCount, Examples
